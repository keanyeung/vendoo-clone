// Prisma schema for the vendoo-clone reselling app.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ItemStatus {
  DRAFT
  LISTED
  SOLD
}

enum Platform {
  FB_MARKETPLACE
  DEPOP
  EBAY
}

model Item {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Cloud object-storage URLs for the item's photos.
  photos String[]

  // Listing content (AI-drafted, user-editable).
  title          String
  summary        String? @db.Text // one-sentence product summary, used in platform copy (e.g. Facebook)
  description    String  @db.Text
  brand          String?
  category       String?
  size           String?
  color          String?
  condition      String? // one of CONDITION_VALUES; kept as text so tiers can change without a migration
  conditionNotes String? @db.Text

  // Pricing.
  suggestedPrice Decimal? @db.Decimal(10, 2) // AI estimate
  priceLow       Decimal? @db.Decimal(10, 2) // AI resale range, low end
  priceHigh      Decimal? @db.Decimal(10, 2) // AI resale range, high end
  priceReasoning String?  @db.Text // why the AI landed on that price
  listPrice      Decimal  @db.Decimal(10, 2) // what you actually listed at
  purchasePrice  Decimal  @db.Decimal(10, 2) // what you paid

  // Other AI output.
  keywords     String[] @default([])
  aiConfidence String? // one of CONFIDENCE_VALUES

  // Your own sourcing details.
  purchaseDate DateTime?
  notes        String?   @db.Text // private notes, never shown in a listing

  status    ItemStatus @default(LISTED)
  draftStep String? // how far an unfinished /new draft got: photos | analyzed | reviewed

  // Sale details (populated when the item sells).
  soldPrice    Decimal?  @db.Decimal(10, 2)
  soldPlatform Platform?
  soldDate     DateTime?
  platformFees Decimal?  @default(0) @db.Decimal(10, 2)
  shippingCost Decimal?  @db.Decimal(10, 2)

  postings ItemPosting[]

  @@index([status])
  @@index([status, updatedAt])
  @@index([createdAt])
}

// One row per marketplace an item has been posted to. A null removedAt means
// the posting is currently live; re-posting reuses the same history row.
model ItemPosting {
  id        String    @id @default(cuid())
  itemId    String
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  platform  Platform
  postedAt  DateTime  @default(now())
  url       String?
  removedAt DateTime?

  @@unique([itemId, platform])
  @@index([itemId])
}

// One row per failed login attempt, used to rate-limit password guessing.
// The client IP is stored as an HMAC (keyed by SESSION_SECRET), never in the
// clear, so the table cannot be used to reconstruct who tried to log in.
model LoginAttempt {
  id        String   @id @default(cuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
