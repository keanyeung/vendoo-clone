# --- Database (Supabase Postgres) ---
# Pooled connection string used by the app at runtime (Supabase: port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection used by Prisma for migrations (Supabase: port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth ---
# Secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
# Single-user password to log in to the app.
APP_PASSWORD="change-me"

# --- Supabase Storage (photo uploads) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Secret ("service_role") key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_replace-me"
# Name of the public Storage bucket that holds item photos.
SUPABASE_STORAGE_BUCKET="item-photos"

# --- Anthropic (AI listing analysis) ---
# API key from https://console.anthropic.com — SERVER ONLY.
ANTHROPIC_API_KEY="sk-ant-api03-replace-me"
# Model used for photo analysis. Swap to compare quality vs cost:
#   claude-opus-4-8   (default, best vision)
#   claude-sonnet-4-6 (~40% cheaper)
#   claude-haiku-4-5  (cheapest)
ANTHROPIC_MODEL="claude-opus-4-8"
