# --- Database (Supabase Postgres) ---
# Pooled connection string used by the app at runtime (Supabase: port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection used by Prisma for migrations (Supabase: port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Auth ---
# Secret used to sign the session cookie. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
# Single-user password to log in to the app.
APP_PASSWORD="change-me"
